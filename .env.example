# ========================================
# VARIABLES DE ENTORNO - OSINT HUB
# ========================================
# Copia este archivo como .env y configura tus variables

# Django Core
SECRET_KEY=tu-clave-secreta-super-segura-aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database (SQLite para desarrollo, PostgreSQL para producción)
# Desarrollo (SQLite):
# DATABASE_URL=sqlite:///db.sqlite3
# Producción (PostgreSQL en Render):
# DATABASE_URL=postgresql://user:password@host:5432/database

# CSRF Trusted Origins (para producción en Render)
# CSRF_TRUSTED_ORIGINS=https://tu-app.onrender.com

# Configuración de Render.com (solo producción)
# Estas variables se configuran automáticamente en Render:
# PYTHON_VERSION=3.12.3
# DATABASE_URL=<auto-generado por Render>
